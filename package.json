{
  "name": "sedative-physio-blog",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm --prefix server run build && npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "check:deploy": "node scripts/check-deploy-deps.mjs",
    "dev": "concurrently \"npm --prefix server run dev\" \"npm --prefix client run dev\"",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "db:seed": "npm --prefix server run db:seed",
    "db:seed:courses": "npm --prefix server run db:seed:courses",
    "db:seed:notes": "npm --prefix server run db:seed:notes",
    "db:seed:models": "npm --prefix server run db:seed:models"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1125.0",
    "@aws-sdk/s3-request-presigner": "^3.1125.0",
    "@clerk/backend": "^3.16.13",
    "@clerk/express": "^2.1.64",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "jose": "^6.2.12",
    "multer": "^2.3.0",
    "nodemailer": "^9.1.1",
    "pg": "^8.23.0",
    "razorpay": "^2.9.8",
    "sharp": "^0.35.4",
    "svix": "^2.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@vercel/node": "^5.1.14",
    "concurrently": "^9.1.2",
    "prisma": "^7.10.0",
    "typescript": "~6.0.2"
  }
}
