generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============ ENUMS ============

enum NoteStatus {
  PENDING
  UPLOADED
  FAILED
}

enum LessonType {
  VIDEO
  ARTICLE
  QUIZ
  PROJECT
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
}

// ============ AUTH & USERS ============
//
// Clerk owns identity: credentials, sessions, email/phone verification and
// social login. This table owns domain data only — the student's profile and
// everything that hangs off it (orders, enrollments, audit trail). The two are
// joined by `clerkUserId`, mirrored from Clerk's `user.created`/`user.updated`
// webhooks. See server/src/auth/webhook.ts.

model User {
  id              String    @id @default(cuid())
  clerkUserId     String?   @unique // null until the Clerk webhook creates the row
  email           String?   @unique // mirrored from Clerk, lowercased; for display + order records
  emailVerifiedAt DateTime? // mirrored from Clerk's email verification status
  fullName        String? // promoted to NOT NULL once existing rows are backfilled
  collegeName     String?
  role            String    @default("user")
  deletedAt       DateTime? // set when the Clerk user is deleted; the row is kept for order history
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  orders        Order[]
  enrollments   Enrollment[]
  authAuditLogs AuthAuditLog[]
}

// Credentials, sessions and one-time tokens are Clerk's responsibility, so the
// custom-auth models (RefreshToken, VerificationToken) were removed rather than
// left to drift out of sync with Clerk's own state.

model AuthAuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  event     String
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ============ NOTES ============

model Note {
  id            String     @id @default(cuid())
  title         String
  description   String?    @db.Text
  tag           String?
  category      String     @default("notes")
  image         String?
  imageDark     String?    // cover image shown in dark mode; falls back to `image`
  imagePublicId String?
  fileKey       String?    // object key inside the R2 bucket (e.g. "notes/anatomy-ch1.pdf"); null until a file is uploaded
  fileName      String?
  fileSize      Int?       // bytes
  status        NoteStatus @default(PENDING)
  uploadedAt    DateTime?
  isPublished   Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([category, isPublished])
  @@index([isPublished])
  @@index([status])
}

// ============ 3D MODELS ============

model Model3D {
  id          String   @id @default(cuid())
  name        String
  fileKey     String   // path inside the GitHub repo (e.g. "models/human-anatomy.glb")
  fileName    String
  fileSize    Int      // bytes
  jsDelivrUrl String
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// ============ TUTORS ============

model Tutor {
  id          String   @id @default(cuid())
  name        String
  designation String?
  image       String?
  bio         String?  @db.Text
  courses     Course[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============ COURSES ============

model Course {
  id               String         @id @default(cuid())
  title            String
  slug             String         @unique
  shortDescription String?        @db.Text
  thumbnail        String?
  level            String         @default("Beginner")
  language         String         @default("English")
  estimatedHours   Int?
  highlights       String[]       @default([])
  price            Int            @default(0) // in paise; 0 = free
  isFree           Boolean        @default(true)
  isPublished      Boolean        @default(false)
  tutorId          String?
  tutor            Tutor?         @relation(fields: [tutorId], references: [id], onDelete: SetNull)
  sections         CourseSection[]
  enrollments      Enrollment[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([isPublished])
}

model CourseSection {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  order       Int
  lessons     Lesson[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId, order])
}

model Lesson {
  id          String        @id @default(cuid())
  sectionId   String
  section     CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title       String
  slug        String
  type        LessonType
  content     String?       @db.Text
  videoUrl    String?
  duration    Int?
  isPreview   Boolean       @default(false)
  isPublished Boolean       @default(false)
  order       Int
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([sectionId, slug])
  @@index([sectionId, order])
}

// ============ ORDERS & PAYMENTS ============

model Order {
  id                String      @id @default(cuid())
  userId            String?
  user              User?       @relation(fields: [userId], references: [id], onDelete: Restrict)
  userEmail         String?
  userName          String?
  amount            Int         // in paise
  currency          String      @default("INR")
  status            OrderStatus @default(PENDING)
  razorpayOrderId   String      @unique
  razorpayPaymentId String?
  razorpaySignature String?
  courseIds         String[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([userId])
  @@index([status])
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}