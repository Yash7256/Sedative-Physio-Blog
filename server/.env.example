PORT=4000
NODE_ENV=development

# Postgres. Required — every /api/notes, /api/models and /api/courses request
# fails without it. Also the only database var: there is no separate DIRECT_URL.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Auth. Clerk owns credentials, sessions, email/phone verification and social
# login. The local `User` table is a domain profile joined by `clerkUserId`.
# Keys: Dashboard -> API Keys. The webhook secret is per-endpoint
# (Dashboard -> Webhooks -> your endpoint -> Signing Secret).
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# Comma-separated browser origins allowed to send credentialed requests
# (Clerk's session cookies are HttpOnly and must be sent cross-origin).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Razorpay checkout.
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# GitHub (GLB model storage)
GITHUB_TOKEN=ghp_...
GITHUB_REPO_OWNER=yash
GITHUB_REPO_NAME=Sedative-Physio-Blog
GITHUB_REPO_BRANCH=main

# SMTP (contact form emails). Without these the contact route still accepts
# submissions but only logs them instead of sending.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password
CONTACT_EMAIL=sedativephysio@gmail.com
