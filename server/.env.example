PORT=4000
NODE_ENV=development

# Postgres. Required — every /api/notes, /api/models and /api/courses request
# fails without it. Also the only database var: there is no separate DIRECT_URL.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Auth. RSA key pair in PEM form; the public key must match the private key.
AUTH_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
AUTH_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Absolute URLs used in verification and password-reset emails.
VERIFY_EMAIL_URL=http://localhost:5173/verify-email
RESET_PASSWORD_URL=http://localhost:5173/reset-password

# Comma-separated browser origins allowed to send credentialed requests.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Razorpay checkout.
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# GitHub (GLB model storage)
GITHUB_TOKEN=ghp_...
GITHUB_REPO_OWNER=yash
GITHUB_REPO_NAME=Sedative-Physio-Blog
GITHUB_REPO_BRANCH=main

# SMTP (contact form emails). Without these the contact route still accepts
# submissions but only logs them instead of sending.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password
CONTACT_EMAIL=sedativephysio@gmail.com
